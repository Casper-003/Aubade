<Window x:Class="Vesper.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Vesper">
  <Grid x:Name="Root" Loaded="OnLoaded" SizeChanged="OnLayoutChanged">
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="AppTitleBar" Background="Transparent">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="TitlePaneColumn" Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel x:Name="BrandArea" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
        <Button x:Name="BackButton" Width="32" Height="32" Padding="0" Visibility="Collapsed" Click="OnBack" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="后退" AutomationProperties.Name="后退"><FontIcon Glyph="&#xE72B;" FontSize="16" FontFamily="{ThemeResource SymbolThemeFontFamily}"/></Button>
        <Border Width="20" Height="20" BorderBrush="{ThemeResource TextFillColorSecondaryBrush}" BorderThickness="1" CornerRadius="3" ToolTipService.ToolTip="软件图标占位，待提供正式图稿"/>
        <TextBlock Text="Vesper" VerticalAlignment="Center"/>
      </StackPanel>
      <Button x:Name="SingingEntry" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsEnabled="False" AutomationProperties.Name="演唱入口" ToolTipService.ToolTip="演唱入口，Logo 尚待提供">
        <Button.Transitions>
          <TransitionCollection><RepositionThemeTransition IsStaggeringEnabled="False"/></TransitionCollection>
        </Button.Transitions>
        <Border Width="24" Height="24" BorderBrush="{ThemeResource TextFillColorDisabledBrush}" BorderThickness="1" CornerRadius="3"/>
      </Button>
    </Grid>
    <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Left" IsPaneOpen="True"
        OpenPaneLength="220" CompactPaneLength="56" AlwaysShowHeader="False"
        IsBackButtonVisible="Collapsed" IsSettingsVisible="True" SelectionChanged="OnSelectionChanged">
      <NavigationView.Resources><SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#39C5BB"/></NavigationView.Resources>
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="HomeItem" Content="首页" Tag="首页" Icon="Home"/>
        <NavigationViewItem Content="搜索" Tag="搜索" Icon="Find"/>
        <NavigationViewItem Content="收藏" Tag="收藏" Icon="Favorite"/>
        <NavigationViewItem Content="曲库" Tag="曲库" Icon="Library"/>
        <NavigationViewItem Content="创作" Tag="创作" Icon="Edit"/>
      </NavigationView.MenuItems>
      <Grid x:Name="PageArea" Padding="28,24" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock x:Name="PageTitle" Text="首页" Style="{StaticResource TitleTextBlockStyle}"/>
        <StackPanel x:Name="AppearancePanel" Grid.Row="1" Margin="0,28,0,0" Spacing="12" Visibility="Collapsed">
          <TextBlock Text="强调色" Style="{StaticResource SubtitleTextBlockStyle}"/>
          <RadioButton x:Name="VesperAccent" Content="Vesper（Miku 蓝）" GroupName="Accent" Checked="OnAccentChanged"/>
          <RadioButton x:Name="SystemAccent" Content="跟随 Windows 系统强调色" GroupName="Accent" Checked="OnAccentChanged"/>
        </StackPanel>
        <InfoBar x:Name="PreferenceNotice" Grid.Row="1" VerticalAlignment="Bottom" Severity="Warning" IsOpen="False" Message="界面偏好未能保存，下次启动可能恢复默认。"/>
      </Grid>
    </NavigationView>
  </Grid>
</Window>
